                  "pm.test(\"Response is an array\", () => {\r",
                  "  pm.expect(data).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Array is not empty\", () => {\r",
                  "  pm.expect(data.length).to.be.greaterThan(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"First item has bookingid\", () => {\r",
                  "  pm.expect(data[0]).to.have.property(\"bookingid\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is under 2000ms\", () => {\r",
                  "  pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "const list = pm.response.json();\r",
                  "pm.environment.set(\"bookingId\", String(list[0].bookingid));\r",
                  "\r",
                  "pm.test(\"Array is not empty\", () => {\r",
                  "  pm.expect(data.length).to.be.greaterThan(0);\r",
                  "});\r",
                  "\r",
                  "if (data.length > 0) {\r",
                  "  pm.environment.set(\"bookingId\", String(data[0].bookingid));\r",
                  "}\r",
                  "\r",
                  ""
